    },
    {
      "Type": "character",
      "AssetId": "roman/roman_surprised",
      "Action": "show",
      "Position": "left",
      "Width": 620,
      "Height": 930
    },
    {
      "Type": "character",
      "AssetId": "ai/ai_normal",
      "Action": "show",
      "Position": "right",
      "Width": 320,
      "Height": 320,
      "OffsetY": 120
    },
    {
      "Type": "fade",
      "Action": "in",
      "Duration": 0.8
    },
    {
      "Type": "description",
      "Text": "宇宙空間。少女たちの宇宙船。遠方に惑星が見える。"
    },
    {
      "Type": "dialogue",
      "Id": "s08_001",
      "Speaker": "ろまん",
      "Text": "ここまで離れれば、もう大丈夫でしょう"
    },
    {
      "Type": "dialogue",
      "Id": "s08_002",
      "Speaker": "ろまん",
      "Text": "……あれ？"
    },
    {
      "Type": "dialogue",
      "Id": "s08_003",
      "Speaker": "ハウエル",
      "Text": "惑星表面に大規模なエネルギー反応を検知しました"
    },
    {
      "Type": "dialogue",
      "Id": "s08_004",
      "Speaker": "ろまん",
      "Text": "あれまあ……"
    },
    {
      "Type": "background",
      "AssetId": "episode01/scene08/spaceship_planet_explosion"
    },
    {
      "Type": "description",
      "Text": "惑星が爆発する。"
    },
    {
      "Type": "dialogue",
      "Id": "s08_005",
      "Speaker": "ろまん",
      "Text": "…………"
    },
    {
      "Type": "dialogue",
      "Id": "s08_006",
      "Speaker": "ろまん",
      "Text": "おじいさん……"
    },
    {
      "Type": "dialogue",
      "Id": "s08_007",
      "Speaker": "ハウエル",
      "Text": "…………"
    },
    {
      "Type": "dialogue",
      "Id": "s08_008",
      "Speaker": "ハウエル",
      "Text": "惑星から通信を受信しました"
    },
    {
      "Type": "dialogue",
      "Id": "s08_009",
      "Speaker": "ろまん",
      "Text": "通信？"
    },
    {
      "Type": "dialogue",
      "Id": "s08_010",
      "Speaker": "ハル",
      "Text": "ハラスメント発生件数、0件"
    },
    {
      "Type": "dialogue",
      "Id": "s08_011",
      "Speaker": "ハル",
      "Text": "政策目標を達成しました"
    },
    {
      "Type": "dialogue",
      "Id": "s08_012",
      "Speaker": "ろまん",
      "Text": "…………"
    },
    {
      "Type": "dialogue",
      "Id": "s08_013",
      "Speaker": "ハウエル",
      "Text": "…………"
    },
    {
      "Type": "dialogue",
      "Id": "s08_014",
      "Speaker": "ろまん",
      "Text": "ハラスメントをなくすために、惑星を滅亡させるなんて……本末転倒じゃない"
    },
    {
      "Type": "fade",
      "Action": "out",
      "Duration": 0.7
    },
    {
      "Type": "bgm",
      "Action": "play",
      "AssetId": "scene01_space"
    },
    {
      "Type": "background",
      "AssetId": "episode01/scene01/spaceship_interior"
    },
    {
      "Type": "character",
      "AssetId": "roman/roman_normal",
      "Action": "show",
      "Position": "left",
      "Width": 620,
      "Height": 930
    },
    {
      "Type": "fade",
      "Action": "in",
      "Duration": 0.7
    },
    {
      "Type": "dialogue",
      "Id": "s08_015",
      "Speaker": "ろまん",
      "Text": "やっぱり、何でもAIに任せればいいってものじゃないわね"
    },
    {
      "Type": "dialogue",
      "Id": "s08_016",
      "Speaker": "ハウエル",
      "Text": "……私の前でそれを言いますか？"
    },
    {
      "Type": "dialogue",
      "Id": "s08_017",
      "Speaker": "ろまん",
      "Text": "あ"
    },
    {
      "Type": "dialogue",
      "Id": "s08_018",
      "Speaker": "ろまん",
      "Text": "いや、あなたのことじゃなくて"
    },
    {
      "Type": "dialogue",
      "Id": "s08_019",
      "Speaker": "ハウエル",
      "Text": "存じております"
    },
    {
      "Type": "dialogue",
      "Id": "s08_020",
      "Speaker": "ろまん",
      "Text": "……本当に？"
    },
    {
      "Type": "dialogue",
      "Id": "s08_021",
      "Speaker": "ハウエル",
      "Text": "はい"
    },
    {
      "Type": "dialogue",
      "Id": "s08_022",
      "Speaker": "ろまん",
      "Text": "便利だからって、何でも任せちゃダメなのよ"
    },
    {
      "Type": "dialogue",
      "Id": "s08_023",
      "Speaker": "ろまん",
      "Text": "AIは言われたことを、ものすごい速さで進めてくれるけど……"
    },
    {
      "Type": "dialogue",
      "Id": "s08_024",
      "Speaker": "ろまん",
      "Text": "そもそも、どっちへ進むのか。それくらいは自分たちで決めないとね"
    },
    {
      "Type": "dialogue",
      "Id": "s08_025",
      "Speaker": "ハウエル",
      "Text": "はい"
    },
    {
      "Type": "dialogue",
      "Id": "s08_026",
      "Speaker": "ろまん",
      "Text": "…………"
    },
    {
      "Type": "dialogue",
      "Id": "s08_027",
      "Speaker": "ろまん",
      "Text": "でもさ"
    },
    {
      "Type": "dialogue",
      "Id": "s08_028",
      "Speaker": "ハウエル",
      "Text": "はい？"
    },
    {
      "Type": "dialogue",
      "Id": "s08_029",
      "Speaker": "ろまん",
      "Text": "私たちも、本当に自分で決めてるのかな"
    },
    {
      "Type": "dialogue",
      "Id": "s08_030",
      "Speaker": "ハウエル",
      "Text": "……と、申しますと？"
    },
    {
      "Type": "dialogue",
      "Id": "s08_031",
      "Speaker": "ろまん",
      "Text": "だって私、さっきから誰かに喋らされてるような気がするの"
    },
    {
      "Type": "dialogue",
      "Id": "s08_032",
      "Speaker": "ハウエル",
      "Text": "…………"
    },
    {
      "Type": "dialogue",
      "Id": "s08_033",
      "Speaker": "ろまん",
      "Text": "立つ場所も、表情も……"
    },
    {
      "Type": "dialogue",
      "Id": "s08_034",
      "Speaker": "ろまん",
      "Text": "見えてる景色まで、誰かに決められてるような……"
    },
    {
      "Type": "dialogue",
      "Id": "s08_035",
      "Speaker": "ろまん",
      "Text": "生成AIと、それを操作する奇特な男性……？"
    },
    {
      "Type": "dialogue",
      "Id": "s08_036",
      "Speaker": "ハウエル",
      "Text": "気のせいではないでしょうか"
    },
    {
      "Type": "dialogue",
      "Id": "s08_037",
      "Speaker": "ろまん",
      "Text": "そうかなあ"
    },
    {
      "Type": "dialogue",
      "Id": "s08_038",
      "Speaker": "ハウエル",
      "Text": "ところで、次の目的地が決まりました"
    },
    {
      "Type": "dialogue",
      "Id": "s08_039",
      "Speaker": "ろまん",
      "Text": "え、もう？"
    },
    {
      "Type": "dialogue",
      "Id": "s08_040",
      "Speaker": "ハウエル",
      "Text": "はい。興味深い惑星です"
    },
    {
      "Type": "dialogue",
      "Id": "s08_041",
      "Speaker": "ろまん",
      "Text": "今度は普通の星だといいんだけど……"
    },
    {
      "Type": "dialogue",
      "Id": "s08_042",
      "Speaker": "ハウエル",
      "Text": "それは保証いたしかねます"
    },
    {
      "Type": "dialogue",
      "Id": "s08_043",
      "Speaker": "ろまん",
      "Text": "だよね……"
    },
    {
      "Type": "character",
      "Action": "hide",
      "Position": "right"
    },
    {
      "Type": "character",
      "Action": "hide",
      "Position": "left"
    },
    {
      "Type": "background",
      "AssetId": "episode01/scene01/space_exterior"
    },
    {
      "Type": "description",
      "Text": "次の惑星に着くまでの間、少女は宇宙船の片隅に積んである本を読んで過ごすことにする。"
    },
    {
      "Type": "description",
      "Text": "果たして、次に着くのはどのような星なのだろうか。"
    },
    {
      "Type": "fade",
      "Action": "out",
      "Duration": 0.8
    },
    {
      "Type": "end"
    }
  ]
}
